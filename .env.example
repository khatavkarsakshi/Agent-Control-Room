# ---------------------------------------------------------------------------
# Agent Control Room - environment template
# Copy to .env and fill in real secrets. .env is git-ignored.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=Agent Control Room
APP_VERSION=0.4.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=acr
POSTGRES_PASSWORD=acr_password
POSTGRES_DB=acr
POSTGRES_PORT=5432
# Inside Docker use host `postgres`; for local uvicorn use `localhost`.
DATABASE_URL=postgresql+psycopg://acr:acr_password@postgres:5432/acr
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false

# --- Redis (broker, live events, rate limiting, cancellation) --------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
EVENTS_ENABLED=true
# EVENTS_ENABLED=false disables live SSE/WebSocket fan-out (useful in tests).

# --- LLM providers ---------------------------------------------------------
# A leaked key must be rotated at the provider; never commit a real key.
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o-mini
# Comma separated model prefixes routed to a local OpenAI-compatible endpoint.
LOCAL_MODEL_PREFIXES=
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=local
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=30

# --- Agent execution -------------------------------------------------------
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOKENS=2048
AGENT_TEMPERATURE=0
AGENT_DEFAULT_TIMEOUT_SECONDS=600
TOOL_TIMEOUT_SECONDS=30
HTTP_TOOL_ALLOW_PRIVATE_NETWORKS=false
HTTP_TOOL_MAX_RESPONSE_BYTES=100000
RUN_MAX_INPUT_CHARS=100000

# --- Traces and retention --------------------------------------------------
TRACE_RETENTION_DAYS=30
TRACE_CLEANUP_BATCH_SIZE=5000
DAILY_COST_RETENTION_DAYS=365
# JSON object of USD-per-million overrides: {"model": {"input": 1.0, "output": 2.0}}
CUSTOM_PRICING_JSON={}

# --- Evaluation and replay (Phase 4) ---------------------------------------
# Automatic evaluation when a run completes. Off by default: Ragas/DeepEval
# judge metrics call a paid model; the `custom` evaluator is deterministic/free.
EVALUATION_AUTO_ON_COMPLETE=false
EVALUATION_AUTO_EVALUATOR=custom
# Comma separated metrics; empty means "the evaluator defaults".
EVALUATION_AUTO_METRICS=
# Contexts for RAG metrics: explicit request wins, else extracted from spans.
EVALUATION_MAX_CONTEXTS=20
EVALUATION_MAX_CONTEXT_CHARS=20000
EVALUATION_REFERENCE_MAX_CHARS=20000
# Judge model used by the optional DeepEval adapter (blank = package default).
EVALUATION_JUDGE_MODEL=
# Cap the character-level output diff performed by replay comparisons.
REPLAY_SIMILARITY_MAX_CHARS=20000

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/health,/docs,/redoc,/openapi.json
TRUST_PROXY_HEADERS=false

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
CORS_ALLOW_CREDENTIALS=false

# --- OpenTelemetry ---------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=agent-control-room
OTEL_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_EXPORT_METRICS=true
OTEL_EXPORT_LOGS=true

# --- Celery ----------------------------------------------------------------
# Leave blank to reuse REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT_SECONDS=900
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=840
CELERY_RESULT_EXPIRES_SECONDS=3600

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Frontend (Phase 3/4) --------------------------------------------------
# Baked into the browser bundle at image build time, so the browser can reach
# the API directly (CORS_ORIGINS above must include this dashboard origin).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_JAEGER_URL=http://localhost:16686
# Server components inside Compose use the internal service name.
FRONTEND_API_BASE_URL=http://backend:8000
FRONTEND_PORT=3000

# --- Ports -----------------------------------------------------------------
BACKEND_PORT=8000
JAEGER_UI_PORT=16686
